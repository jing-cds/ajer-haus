# Neon Postgres connection string for the `ajer_haus` schema's dedicated
# role (NOT Unstitch's role/connection string — see docs/infra-provisioning.md
# for how this role and schema get created inside the shared Neon project).
# Example: postgresql://ajer_haus_app:[password]@[endpoint]-pooler.neon.tech/neondb?sslmode=require&options=-c%20search_path%3Dajer_haus
DATABASE_URL="postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---- Stripe (checkout) ----
# Ajer Haus's OWN Stripe account — never Unstitch's. Secret/restricted key,
# server-side only: Dashboard -> Developers -> API keys -> "Create
# restricted key", scoped to Checkout Sessions + Webhook Endpoints.
STRIPE_SECRET_KEY="sk_test_123456789"
# Webhook signing secret from Dashboard -> Developers -> Webhooks once the
# endpoint exists (or `stripe listen` for local dev).
STRIPE_WEBHOOK_SECRET="whsec_123456789"
# Overrides the origin used for Checkout success/cancel URLs and the order
# magic-link (defaults to the request's Origin header, falling back to
# https://www.ajerhaus.com). Useful for a preview/staging deployment.
# PUBLIC_SITE_URL="https://www.ajerhaus.com"

# ---- Resend (order confirmation, notify-me and contact-form emails) ----
RESEND_API_KEY="re_123456789"
# RESEND_FROM_EMAIL="Ajer Haus <hello@ajerhaus.com>"
# Inbox the "Say hello." contact form relays messages to. Defaults to
# hello@ajerhaus.com.
# CONTACT_INBOX_EMAIL="hello@ajerhaus.com"

# ---- Admin panel (/admin) ----
# Single shared password used to log into /admin. Separate from, and
# unrelated to, Unstitch's admin password.
ADMIN_PASSWORD="change-me-before-launch"
# Signing secret for admin session cookies AND the customer order-lookup
# magic link (src/lib/signedToken.ts). Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-generate-with-openssl-rand-hex-32"
